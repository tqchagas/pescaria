# Banco de dados (Turso / libSQL)
#
# Sem estas variáveis o jogo roda com um arquivo SQLite local em ./data/pescaria.db.
# Na Vercel elas são OBRIGATÓRIAS: sem elas o banco cai no /tmp do Lambda, que é
# apagado a cada cold start (álbum, streak, recordes e mochila se perdem).
#
# Como obter:
#   npm i -g turso
#   turso auth login
#   turso db create pescaria
#   turso db show pescaria --url
#   turso db tokens create pescaria
TURSO_DATABASE_URL=libsql://pescaria-SEU-USUARIO.turso.io
TURSO_AUTH_TOKEN=
